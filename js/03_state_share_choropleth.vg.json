{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Choropleth map: share of the frog species recorded in each state that are on the national list, in four classes.",
  "width": "container",
  "height": 330,
  "projection": {
    "type": "albers",
    "parallels": [
      -18,
      -36
    ],
    "rotate": [
      -132,
      0,
      0
    ]
  },
  "background": null,
  "padding": {
    "left": 60,
    "right": 5,
    "top": 5,
    "bottom": 5
  },
  "layer": [
    {
      "data": {
        "url": "data/australia_states.topojson",
        "format": {
          "type": "topojson",
          "feature": "ne_10m_admin_1_states_provinces"
        }
      },
      "transform": [
        {
          "lookup": "properties.name",
          "from": {
            "data": {
              "url": "data/ala_listed_share_by_state.csv"
            },
            "key": "name",
            "fields": [
              "species_recorded",
              "listed_species_recorded",
              "share_pct"
            ]
          }
        },
        {
          "calculate": "datum.share_pct < 5 ? 'Under 5%' : datum.share_pct < 10 ? '5% to 10%' : datum.share_pct < 20 ? '10% to 20%' : '20% or more'",
          "as": "class_label"
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#7b8794",
        "strokeWidth": 0.8
      },
      "encoding": {
        "color": {
          "field": "class_label",
          "type": "nominal",
          "title": "Listed share of recorded frog species",
          "scale": {
            "domain": [
              "Under 5%",
              "5% to 10%",
              "10% to 20%",
              "20% or more"
            ],
            "range": [
              "#d4c0f0",
              "#a97fe0",
              "#652bb0",
              "#260848"
            ]
          },
          "legend": {
            "orient": "none",
            "direction": "horizontal",
            "symbolType": "square",
            "symbolSize": 196,
            "titleLimit": 300,
            "legendX": 0,
            "legendY": 368
          }
        },
        "tooltip": [
          {
            "field": "properties.name",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "species_recorded",
            "type": "quantitative",
            "title": "Frog species recorded"
          },
          {
            "field": "listed_species_recorded",
            "type": "quantitative",
            "title": "Of which listed"
          },
          {
            "field": "share_pct",
            "type": "quantitative",
            "title": "Share (%)",
            "format": ".1f"
          }
        ]
      },
      "description": "States coloured by class"
    },
    {
      "data": {
        "url": "data/state_labels.csv"
      },
      "transform": [
        {
          "lookup": "name",
          "from": {
            "data": {
              "url": "data/ala_listed_share_by_state.csv"
            },
            "key": "name",
            "fields": [
              "share_pct"
            ]
          }
        },
        {
          "calculate": "[datum.name, format(datum.share_pct, '.0f') + '%']",
          "as": "label"
        },
        {
          "calculate": "datum.name == 'New South Wales' ? +datum.longitude + 1.4 : (datum.name == 'Victoria' ? 143.0 : +datum.longitude)",
          "as": "label_lon"
        },
        {
          "calculate": "datum.name == 'Victoria' ? -36.2 : +datum.latitude",
          "as": "label_lat"
        },
        {
          "calculate": "datum.name == 'Victoria' ? 0 : +datum.outside",
          "as": "label_outside"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 13,
        "lineHeight": 13,
        "fontWeight": "normal"
      },
      "encoding": {
        "longitude": {
          "field": "label_lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "label_lat",
          "type": "quantitative"
        },
        "text": {
          "field": "label",
          "type": "nominal"
        },
        "color": {
          "condition": {
            "test": "datum.label_outside == 0 && datum.share_pct >= 10",
            "value": "#ffffff"
          },
          "value": "#1f2933"
        }
      },
      "description": "State names and shares (white text on the dark classes)"
    },
    {
      "data": {
        "url": "data/ala_listed_share_by_state.csv"
      },
      "transform": [
        {
          "filter": "datum.name == 'Australian Capital Territory'"
        },
        {
          "calculate": "datum.share_pct < 5 ? 'Under 5%' : datum.share_pct < 10 ? '5% to 10%' : datum.share_pct < 20 ? '10% to 20%' : '20% or more'",
          "as": "class_label"
        },
        {
          "calculate": "149.13",
          "as": "lon"
        },
        {
          "calculate": "-35.31",
          "as": "lat"
        },
        {
          "calculate": "153.0",
          "as": "lon2"
        },
        {
          "calculate": "-36.3",
          "as": "lat2"
        }
      ],
      "mark": {
        "type": "rule",
        "color": "#3e4a56",
        "strokeWidth": 1
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "longitude2": {
          "field": "lon2"
        },
        "latitude2": {
          "field": "lat2"
        }
      },
      "description": "Line from the Australian Capital Territory to its label"
    },
    {
      "data": {
        "url": "data/ala_listed_share_by_state.csv"
      },
      "transform": [
        {
          "filter": "datum.name == 'Australian Capital Territory'"
        },
        {
          "calculate": "datum.share_pct < 5 ? 'Under 5%' : datum.share_pct < 10 ? '5% to 10%' : datum.share_pct < 20 ? '10% to 20%' : '20% or more'",
          "as": "class_label"
        },
        {
          "calculate": "149.13",
          "as": "lon"
        },
        {
          "calculate": "-35.31",
          "as": "lat"
        },
        {
          "calculate": "153.0",
          "as": "lon2"
        },
        {
          "calculate": "-36.3",
          "as": "lat2"
        }
      ],
      "mark": {
        "type": "circle",
        "size": 60,
        "fill": null,
        "stroke": "white",
        "strokeWidth": 1.6,
        "opacity": 1
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        }
      },
      "description": "Ring that marks where the Australian Capital Territory is"
    },
    {
      "data": {
        "url": "data/ala_listed_share_by_state.csv"
      },
      "transform": [
        {
          "filter": "datum.name == 'Australian Capital Territory'"
        },
        {
          "calculate": "datum.share_pct < 5 ? 'Under 5%' : datum.share_pct < 10 ? '5% to 10%' : datum.share_pct < 20 ? '10% to 20%' : '20% or more'",
          "as": "class_label"
        },
        {
          "calculate": "149.13",
          "as": "lon"
        },
        {
          "calculate": "-35.31",
          "as": "lat"
        },
        {
          "calculate": "153.0",
          "as": "lon2"
        },
        {
          "calculate": "-36.3",
          "as": "lat2"
        }
      ],
      "mark": {
        "type": "square",
        "size": 120,
        "stroke": "#7b8794",
        "strokeWidth": 0.8,
        "opacity": 1
      },
      "encoding": {
        "longitude": {
          "field": "lon2",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat2",
          "type": "quantitative"
        },
        "color": {
          "field": "class_label",
          "type": "nominal",
          "scale": {
            "domain": [
              "Under 5%",
              "5% to 10%",
              "10% to 20%",
              "20% or more"
            ],
            "range": [
              "#d4c0f0",
              "#a97fe0",
              "#652bb0",
              "#260848"
            ]
          },
          "legend": null
        }
      },
      "description": "Square in the class colour of the Australian Capital Territory, next to its label"
    },
    {
      "data": {
        "url": "data/ala_listed_share_by_state.csv"
      },
      "transform": [
        {
          "filter": "datum.name == 'Australian Capital Territory'"
        },
        {
          "calculate": "datum.share_pct < 5 ? 'Under 5%' : datum.share_pct < 10 ? '5% to 10%' : datum.share_pct < 20 ? '10% to 20%' : '20% or more'",
          "as": "class_label"
        },
        {
          "calculate": "149.13",
          "as": "lon"
        },
        {
          "calculate": "-35.31",
          "as": "lat"
        },
        {
          "calculate": "153.0",
          "as": "lon2"
        },
        {
          "calculate": "-36.3",
          "as": "lat2"
        },
        {
          "calculate": "['Australian Capital', 'Territory ' + format(datum.share_pct, '.0f') + '%']",
          "as": "label"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 14,
        "fontSize": 13,
        "lineHeight": 13,
        "color": "#1f2933"
      },
      "encoding": {
        "longitude": {
          "field": "lon2",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat2",
          "type": "quantitative"
        },
        "text": {
          "field": "label",
          "type": "nominal"
        },
        "opacity": {
          "value": 1
        }
      },
      "description": "Label of the Australian Capital Territory"
    },
    {
      "data": {
        "values": [
          {
            "note": [
              "Frogs like wet places,",
              "so most species may be",
              "recorded in the",
              "wetter east."
            ]
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "top",
        "fontSize": 14,
        "lineHeight": 18,
        "color": "#1f2933"
      },
      "encoding": {
        "x": {
          "value": 0
        },
        "y": {
          "value": 214
        },
        "text": {
          "field": "note",
          "type": "nominal"
        },
        "opacity": {
          "value": 1
        }
      },
      "description": "Annotation: frogs like wet places, so most species may be recorded in the wetter east (general knowledge; species counts in this chart's data)"
    }
  ],
  "title": {
    "text": "Share of recorded frog species that are listed, by state",
    "anchor": "start",
    "frame": "bounds",
    "fontSize": 18,
    "fontWeight": "bold",
    "color": "#0f3d75",
    "offset": 20,
    "orient": "top"
  },
  "view": {
    "stroke": null
  }
}
